# Composer API Credentials
COMPOSER_API_KEY=your_api_key_here
COMPOSER_API_SECRET=your_api_secret_here
# Optional: Target specific account (leave empty for default)
COMPOSER_ACCOUNT_UUID=

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Trading Configuration
TOTAL_CAPITAL=100000
DRY_RUN=true  # Set to false for live trading

# Scheduling (3:40 PM ET for Composer's 3:45-4:00 PM trading window)
REBALANCE_TIME=15:40
TIMEZONE=America/New_York

# Database
DUCKDB_PATH=data/trading.duckdb

# Schwab API Credentials (Alternative to Composer)
# Get credentials from https://developer.schwab.com
SCHWAB_API_KEY=your_schwab_api_key_here
SCHWAB_API_SECRET=your_schwab_api_secret_here
SCHWAB_REDIRECT_URI=https://localhost:8182
SCHWAB_ACCOUNT_HASH=  # Optional: Target specific account
SCHWAB_TOKEN_PATH=/app/data/schwab_tokens.json  # Token storage path
SCHWAB_DRY_RUN=true  # Set to false for live trading

# Tiingo API (for market data)
TIINGO_API_TOKEN=your_tiingo_token_here
